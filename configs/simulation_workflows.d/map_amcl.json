{
  "schema": "ugrp.local_workflow_catalog.v1",
  "workflows": [
    {
      "id": "map-amcl-replay",
      "version": "1.0.0",
      "purpose": "Default-off PR480 80-interval saved-RGB AMCL comparison; no physics",
      "entry": "scripts/replay_map_amcl.py",
      "runner": "scripts.replay_map_amcl",
      "docs": "experiments/2026-10-15-map-amcl/amcl1.md",
      "requires": "committed source and saved RGB or verified feature packets; no renderer",
      "output_flag": "--output",
      "output_kind": "directory",
      "required_inputs": [
        "--raw-root"
      ],
      "side_effect": "offline_analysis",
      "adapter": "managed_legacy_cli"
    },
    {
      "id": "map-amcl-record",
      "version": "1.0.0",
      "purpose": "Default-off GCP fresh own-camera 10 Hz localization recording using existing E2E drive owners",
      "entry": "scripts/record_map_amcl.py",
      "runner": "scripts.record_map_amcl",
      "docs": "experiments/2026-10-15-map-amcl/amcl2.md",
      "requires": "Linux gcp1 n4-highcpu-64, exact-source coordinator approval, --execute, finite source/disk/speed gates",
      "output_flag": "--output",
      "output_kind": "directory",
      "required_inputs": [
        "--seed",
        "--expected-source-sha"
      ],
      "side_effect": "remote_simulation",
      "adapter": "managed_legacy_cli",
      "shutdown_grace_s": 60
    },
    {
      "id": "map-amcl-compare-recording",
      "version": "1.0.0",
      "purpose": "Verify all fresh GCP frames then paired fused odom and four AMCL candidates offline",
      "entry": "scripts/compare_map_amcl_recording.py",
      "runner": "scripts.compare_map_amcl_recording",
      "docs": "experiments/2026-10-15-map-amcl/amcl2.md",
      "requires": "Complete byte-verified gcp1 recordings; no simulation or renderer",
      "output_flag": "--output",
      "output_kind": "directory",
      "required_inputs": [
        "--raw-root",
        "--recording-source-sha"
      ],
      "side_effect": "offline_analysis",
      "adapter": "managed_legacy_cli"
    }
  ]
}
