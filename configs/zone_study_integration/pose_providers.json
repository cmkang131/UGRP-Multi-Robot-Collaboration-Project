{
  "schema": "ugrp.zone_study_pose_providers.v1",
  "note_ko": "tags_temporary와 vision_zero_tag_v2는 별도 등록. v2는 geometry Scene, 명시적 landmark_detail=none, 자기 도크 prior가 필요하다. 모든 제공자에 고정 0.16 SIM s 지연. 물리 성공은 미검증.",
  "interface": {
    "constructor": "factory(static_map, params, seed=int)",
    "methods": [
      "on_command(row)",
      "on_frame(now, rgb) -> PoseReport",
      "report(now) -> PoseReport",
      "set_motion_profile(now, name)"
    ],
    "attributes": [
      "source: str (M1 own-camera label, starts with source_label_prefix)",
      "loc: estimate() and predict_to(now) (executor goto/delivery legs)"
    ]
  },
  "providers": {
    "tags_temporary": {
      "factory": "harness.owncam_pose_source:OwnCamPoseSource",
      "version": "owncam_pf_v2",
      "source_label_prefix": "owncam_pf_v2:",
      "maps": [
        "zone_wide_door_tags_v2",
        "zone_wide_two_doors_tags_v2",
        "zone_wide_door_tags_v3"
      ],
      "calibration": "experiments/2026-09-26-zone-m1-owncam/calibration_m1_dev.json",
      "source_files": [
        "harness/owncam_pose_source.py",
        "harness/owncam_localizer.py",
        "harness/wall_tags.py"
      ],
      "temporary": true,
      "research_result": false,
      "uses_landmark_tags": true,
      "note_ko": "임시, 표식 사용, 연구 결과 아님"
    },
    "vision_zero_tag_v2": {
      "factory": "harness.vision_pose_source:VisionPoseSourceV2",
      "version": "geometry_init_v2",
      "source_label_prefix": "owncam_pf_vision_zero_tag_v2:",
      "maps": [
        "zone_wide_door_geometry_v2"
      ],
      "calibration": "experiments/2026-09-26-zone-m1-owncam/calibration_m1_dev.json",
      "source_files": [
        "harness/vision_pose_source.py",
        "harness/vision_motion_init.py",
        "harness/vision_loc_protocol.py",
        "configs/vision_loc_worker.json",
        "maps/zones/zone_wide_door_geometry_v2.json"
      ],
      "temporary": true,
      "research_result": false,
      "uses_landmark_tags": false,
      "note_ko": "표식 없는 생성 경계만 검증; 물리·모델 실행 미검증"
    }
  }
}
