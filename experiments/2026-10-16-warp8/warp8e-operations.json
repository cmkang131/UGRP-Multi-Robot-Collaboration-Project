            "value": "#!/bin/bash\n# UGRP GCP benchmark VM: idle guard. Powers off after 20 min with no simulation/setup process.\ncat > /usr/local/sbin/ugrp-idle-guard <<'G'\n#!/bin/bash\nstate=/run/ugrp-idle-since\nnow=$(date +%s)\n# Leases block manual stop in gcpctl. A stale detached lease must not disable\n# the independent 20-minute idle backstop once all execution processes are gone.\nif pgrep -u ugrp -x 'python[0-9.]*|mujoco|ffmpeg' >/dev/null; then\n  echo \"$now\" > \"$state\"; exit 0\nfi\nif pgrep -f 'scripts\\.sim_cli|scripts[./](train_grasp_act|prepare_grasp_act_data|evaluate_grasp_act_offline|run_grasp_act_student|grasp_act_student_worker)|gcp_speed_probe|pip install|pip3 install|apt-get|apt install|dpkg|git index-pack|git pack-objects|git reset|pytest|rsync|scp|sshd: ugrp|zstd|tar ' >/dev/null; then\n  echo \"$now\" > \"$state\"; exit 0\nfi\n[ -f \"$state\" ] || echo \"$now\" > \"$state\"\nsince=$(cat \"$state\")\nif [ $((now - since)) -ge 1200 ]; then\n  logger -t ugrp-idle-guard \"idle 20 min, shutting down\"\n  shutdown -h now\nfi\nG\nchmod 755 /usr/local/sbin/ugrp-idle-guard\ncat > /etc/systemd/system/ugrp-idle-guard.service <<'G'\n[Unit]\nDescription=UGRP idle guard\n[Service]\nType=oneshot\nExecStart=/usr/local/sbin/ugrp-idle-guard\nG\ncat > /etc/systemd/system/ugrp-idle-guard.timer <<'G'\n[Unit]\nDescription=UGRP idle guard timer\n[Timer]\nOnBootSec=60\nOnUnitActiveSec=60\n[Install]\nWantedBy=timers.target\nG\nrm -f /run/ugrp-idle-since\nsystemctl daemon-reload\nsystemctl enable --now ugrp-idle-guard.timer\n"
