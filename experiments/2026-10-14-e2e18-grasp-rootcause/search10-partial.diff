new file mode 100644
index 00000000..5fc90e8b
--- /dev/null
+++ b/scripts/analyze_grasp_act_priority.py
@@ -0,0 +1,102 @@
+"""Saved RGB-measurement geometry only; no World, renderer, or remote calls."""
+import argparse
+import json
+import math
+from copy import deepcopy
+from pathlib import Path
+from harness.grasp_act_visible_world import VisibleWorld
+from scripts.replay_grasp_act_nominal_handoff import verified
+from sim.grasp_act_priority import (PARK_Y, beam_xy, world_xy, checked_path,
+                                    reserved_constraints)
+from sim.grasp_act_goal_set import geometry
+from sim.grasp_act_visible_route import constraints
+
+
+def segment_distance(point, a, b):
+    dx,dy=b[0]-a[0],b[1]-a[1]
+    t=max(0.,min(1.,((point[0]-a[0])*dx+(point[1]-a[1])*dy)/max(1e-20,dx*dx+dy*dy)))
+    return math.dist(point,(a[0]+t*dx,a[1]+t*dy))
+
+
+def path_clearance(path, point):
+    return min(segment_distance(point,a,b) for a,b in zip(path,path[1:]))
+
+
+def witness(case):
+    """Existence of a serial path at one frozen visible snapshot, not rollout.
+
+    Hypothetical parking/final poses are used ONLY by this static evaluator.
+    The runtime never receives the partner's route or these synthetic poses.
+    """
+    w=deepcopy(case['world']);bounds=(-20,20,-20,20)
+    teal=next(r for r,e in case['roles'].items() if e=='teal')
+    blue=next(r for r,e in case['roles'].items() if e=='blue')
+    starts={r:list(w['robots'][r]['pose'][:2]) for r in (teal,blue)}
+    park=world_xy(w,(beam_xy(w,starts[blue])[0],PARK_Y))
+    goals={r:geometry(w,r,case['roles'][r],(0.,.203))[3] for r in (teal,blue)}
+    original={r:checked_path(starts[r],goals[r],bounds,constraints(w,r,True)) for r in (teal,blue)}
+    parking=checked_path(starts[blue],park,bounds,constraints(w,blue,True))
+    w['robots'][blue]['pose'][:2]=park
+    first=checked_path(starts[teal],goals[teal],bounds,reserved_constraints(w,teal,'teal',True))
+    w['robots'][teal]['pose'][:2]=goals[teal]
+    second=checked_path(park,goals[blue],bounds,reserved_constraints(w,blue,'blue',True))
+    paths={'blue_parks':parking,'teal_approaches':first,'blue_approaches':second}
+    clearances=({ 'parking_to_stationary_teal':path_clearance(parking,starts[teal]),
+                  'teal_to_parked_blue':path_clearance(first,park),
+                  'blue_to_ready_teal':path_clearance(second,goals[teal]),
+                  'teal_to_reserved_blue_goal':path_clearance(first,goals[blue])}
+                if all(len(p)>=2 for p in paths.values()) else {})
+    return {'episode':case['episode'],'snapshot_elapsed_s':case['elapsed_s'],
+            'input_observer':case['rid'],'starts':starts,'goals':goals,'parking_point':park,
+            'paths':paths,'original_paths':original,
+            'clearance_m':clearances,'required_peer_clearance_m':.34,
+            'exists':bool(clearances) and min(clearances.values())>=.34,
+            'scope':'frozen observed geometry, ideal positions at stage boundaries; not new viewpoints, odometry or physical success'}
+
+
+def extract(run):
+    cases=[];rows=[]
+    for raw in sorted(run.glob('diagnostic/episode-*/raw')):
+        proof=[];p=json.loads(verified(raw,'plan.json',proof));r=json.loads(verified(raw,'result.json',proof))
+        idx=int(raw.parent.name[-3:])
+        record={'idx':idx,'seed':p['seed'],'physical_success':r['physical_success'],
+                'outcomes':{rid:t['outcome'] for rid,t in r['teachers'].items()},
+                'input_audit':r['input_audit'],'raw_proof':proof}
+        rows.append(record)
+        if idx not in (4,11,12,14):continue
+        labels={rid:[json.loads(l) for l in verified(raw,f'teacher-{rid}.jsonl.zst',proof).splitlines()] for rid in p['roles']}
+        inputs=[{'t':v['t'],'measurements':v['visible_measurements']}
+                for l in verified(raw,'eval-only.jsonl.zst',proof).splitlines() if (v:=json.loads(l))]
+        models={rid:VisibleWorld(rid,e) for rid,e in p['roles'].items()};found=False;observations=[]
+        for i,row in enumerate(inputs):
+            for rid,m in models.items():
+                w=m.observe(row['measurements'][rid],row['t']);m.issue(labels[rid][i]['applied_command'])
+                if w['beam'] is None:continue
+                visible=w['visibility'][rid]['visible_probes']>=5
+                if idx!=4 and visible and set(p['roles'])<=set(w['robots']) and w['visibility'][rid]['peers'] and not found:
+                    cases.append({'episode':idx,'rid':rid,'roles':p['roles'],'elapsed_s':row['t']-inputs[0]['t'],
+                                  'world':w,'pwm':labels[rid][i]['applied_command']['pwm'],
+                                  'input':'current visible band and peer + own issued odometry','raw':str(raw)})
+                    found=True
+                if idx!=4 and rid=='r2':
+                    observations.append({'elapsed_s':row['t']-inputs[0]['t'],
+                        'visible_band':visible,'fresh_peers':w['visibility'][rid]['peers'],
+                        'own_beam_xy':beam_xy(w,w['robots'][rid]['pose']),
+                        'peer_beam_xy':{q:beam_xy(w,v['pose']) for q,v in w['robots'].items() if q!=rid}})
+        record['r2_observations']=observations
+        record['recovery']={rid:t.get('recovery_log',[]) for rid,t in r['teachers'].items()}
+    return cases,rows
+
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--run',type=Path,required=True);p.add_argument('--out',type=Path,required=True)
+    p.add_argument('--fixture',type=Path,required=True);a=p.parse_args()
+    cases,rows=extract(a.run)
+    a.fixture.write_text(json.dumps({'source_sha':'793865d20475098f96f6966edf8ea1ccba058f6d','cases':cases},indent=2)+'\n')
+    proof=[witness(c) for c in cases]
+    a.out.write_text(json.dumps({'schema':'ugrp.grasp_act.search10_geometry.v1','rows':rows,'witnesses':proof,
+        'witness_pass_n':sum(w['exists'] for w in proof),'witness_N':len(proof)},indent=2)+'\n')
+    print(json.dumps([{k:w[k] for k in ('episode','exists','clearance_m')} for w in proof]))
+
+
+if __name__=='__main__':main()
