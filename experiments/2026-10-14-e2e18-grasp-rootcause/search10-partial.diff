+"""Search10 fixed-input shadow count; new views/peer improvement unmeasurable."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from harness.grasp_act_contract import IssuedClock
+from harness.grasp_act_input_audit import AuditedTeacherInput,new_input_audit
+from harness.grasp_act_start_sync import GraspStartSync,GraspApproachSync
+from harness.grasp_act_visible_world import VisibleWorld
+from scripts.replay_grasp_act_nominal_handoff import verified
+from scripts.replay_grasp_act_remaining import pinned
+from scripts.replay_grasp_act_recovery import BASELINE,KW
+from scripts.run_grasp_act_teacher import audit_visible_input
+from sim.grasp_act_teacher_v3 import VisibleOnlyGraspTeacher
+from sim.grasp_act_priority import MODE
+
+PARENT='129f1685351adfc3ab9300a8ec541f88e1f481b0'
+
+
+def replay(raw,baseline,parent):
+    proof=[];p=json.loads(verified(raw,'plan.json',proof));result=json.loads(verified(raw,'result.json',proof))
+    assert result['source_sha']==BASELINE and result['weld']=='off' and result['self_pose_source']=='issued'
+    labels={r:[json.loads(l) for l in verified(raw,f'teacher-{r}.jsonl.zst',proof).splitlines()] for r in p['roles']}
+    inputs=[{'t':v['t'],'measurements':v['visible_measurements']}
+            for l in verified(raw,'eval-only.jsonl.zst',proof).splitlines() if (v:=json.loads(l))]
+    previous={r:labels[r][0]['clean_teacher_command'] for r in labels};models={r:VisibleWorld(r,e) for r,e in p['roles'].items()}
+    groups=[{r:cls(r,e,previous[r]['pwm'],**KW,**extra) for r,e in p['roles'].items()} for cls,extra in (
+        (baseline,{}),(parent,{'approach_recovery':'approach_recovery_v2'}),
+        (VisibleOnlyGraspTeacher,{'approach_recovery':'approach_recovery_v2'}),
+        (VisibleOnlyGraspTeacher,{'approach_recovery':'approach_recovery_v2','approach_coordination':MODE}))]
+    syncs=[(GraspApproachSync if i==3 else GraspStartSync)(p['roles'],result['grasp_start_delays_s']) for i in range(4)]
+    clocks=[{r:IssuedClock() for r in labels} for _ in groups]
+    audit=new_input_audit(True,'issued');count={'original_to_search10':0,'parent_to_search10':0};first={k:None for k in count}
+    max_libm=0.;digests=[hashlib.sha256() for _ in groups]
+    for i,row in enumerate(inputs):
+        now=row['t'];worlds={}
+        for r in labels:
+            audit_visible_input(audit,row['measurements'][r]);worlds[r]=AuditedTeacherInput(models[r].observe(row['measurements'][r],now),audit)
+        ticks=[]
+        for j,teachers in enumerate(groups):
+            permits=syncs[j].tick({r:t.prepare_signal(worlds[r],now) for r,t in teachers.items()},now);tick={}
+            for r,t in teachers.items():
+                waiting=j==3 and t.priority.waiting and (t.end=='teal' or t.priority.round==1)
+                skill='wait' if (t.phase=='ready' and not permits[r]) or waiting else 'grasp'
+                elapsed=clocks[j][r].observe((skill,t.end,t.handoff),now,previous[r]['pwm']);t.skill_started=now-elapsed['skill_elapsed_s']
+                cmd,done=t.step(worlds[r],now,permit_pick=permits[r]);tick[r]=(cmd,done,t.phase)
+                digests[j].update(json.dumps(tick[r],sort_keys=True).encode())
+                if j==0:
+                    expected=labels[r][i]['clean_teacher_command']
+                    delta=max(abs(a-b) for a,b in zip(cmd['duration_s'],expected['duration_s']));max_libm=max(max_libm,delta)
+                    assert all(cmd[k]==expected[k] for k in ('t','wheels','pwm')) and delta<=1e-12,(raw,i,r,'baseline')
+                    assert done==labels[r][i]['done'] and t.phase==labels[r][i]['teacher_phase']
+                t.remember_applied(labels[r][i]['applied_command'])
+                if done:t.done_recorded=True
+            ticks.append(tick)
+        assert ticks[1]==ticks[2],(raw,i,'OFF differs from parent')
+        for j,key in enumerate(count):
+            changed=[r for r in labels if ticks[j][r][0]!=ticks[3][r][0]];count[key]+=len(changed)
+            if changed and first[key] is None:first[key]={'tick':i,'elapsed_s':now-inputs[0]['t'],'robots':changed}
+        for r in labels:previous[r]=labels[r][i]['applied_command'];models[r].issue(previous[r])
+    return {'episode':int(raw.parent.name[-3:]),'saved_success':result['physical_success'],
+            'recorded_commands_verified':len(inputs)*len(labels),'off_parent_identical_commands':len(inputs)*len(labels),
+            'shadow_changed_commands':count,'first_divergence':first,'input_audit':audit,
+            'max_recorded_libm_delta_s':max_libm,'command_sha256':[d.hexdigest() for d in digests],'raw_proof':proof}
+
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--run',type=Path,required=True);p.add_argument('--out',type=Path,required=True);a=p.parse_args()
+    baseline,parent=pinned(BASELINE),pinned(PARENT);rows=[]
+    for raw in sorted(a.run.glob('cohort-*/episode-*/raw')):
+        row=replay(raw,baseline,parent);rows.append(row);print(row['episode'],row['shadow_changed_commands'],flush=True)
+    assert len(rows)==40 and sum(r['saved_success'] for r in rows)==34
+    success=[r for r in rows if r['saved_success']]
+    summary={'schema':'ugrp.grasp_act.search10_replay.v1','baseline_sha':BASELINE,'parent_sha':PARENT,
+             'recorded_commands_verified':sum(r['recorded_commands_verified'] for r in rows),
+             'off_parent_identical_commands':sum(r['off_parent_identical_commands'] for r in rows),
+             'successful_command_N':sum(r['recorded_commands_verified'] for r in success),
+             'successful_shadow_changed_commands':{k:sum(r['shadow_changed_commands'][k] for r in success) for k in rows[0]['shadow_changed_commands']},
+             'successful_changed_indices':{k:[r['episode'] for r in success if r['shadow_changed_commands'][k]] for k in rows[0]['shadow_changed_commands']},
+             'invisible_measurements':sum(r['input_audit']['invisible_measurements'] for r in rows),
+             'held_world_reads':sum(r['input_audit']['held_world_reads'] for r in rows),
+             'scope':'same saved measurements and actual issued history; after first divergence counterfactual shadow outputs only; cannot generate new viewpoints or establish peer-block improvement',
+             'rows':rows}
+    a.out.write_text(json.dumps(summary,indent=2)+'\n');print(json.dumps({k:v for k,v in summary.items() if k!='rows'}))
+
+
+if __name__=='__main__':main()
diff --git a/sim/grasp_act_priority.py b/sim/grasp_act_priority.py
new file mode 100644
index 00000000..6265c92b
--- /dev/null
+++ b/sim/grasp_act_priority.py
@@ -0,0 +1,103 @@
+"""Serial approach with static reservations in the *observed* beam frame.
+
+No peer trajectory/pose messages. The fixed schedule is blue parks, teal
+approaches, blue approaches, joint pick. Only the existing READY/GO/ACK
+barrier advances rounds. Reservations are geometry, not measured peer poses.
+"""
+import math
+from sim.grasp_act_visible_route import constraints, free, segment_free
+from sim.grasp_act_teacher import STATION_M
+from scripts.zone_teacher import plan_path
+
+MODE = 'prioritized_approach_v1'
+PARK_Y = -.65
+PARK_TOL = .025
+# Existing .34 peer clearance + .03 READY tolerance + .007 axial choice.
+RESERVED_RADIUS = .17 + .04 + .04
+
+
+def beam_xy(world, xy):
+    x, y, a = world['beam']['pose']; c, s = math.cos(a), math.sin(a)
+    return c*(xy[0]-x)+s*(xy[1]-y), -s*(xy[0]-x)+c*(xy[1]-y)
+
+
+def world_xy(world, xy):
+    x, y, a = world['beam']['pose']; c, s = math.cos(a), math.sin(a)
+    return x+c*xy[0]-s*xy[1], y+s*xy[0]+c*xy[1]
+
+
+def reserved_constraints(world, rid, end, folded):
+    radius, discs, rects = constraints(world, rid, folded)
+    other_x = (.27+STATION_M)*(1 if end == 'teal' else -1)
+    discs.append((*world_xy(world, (other_x, 0.)), RESERVED_RADIUS))
+    # Separate transit on opposite long sides; final axial grasp is unchanged.
+    # This is an extra keepout, never a reduction in a physical margin.
+    sign = -1 if end == 'teal' else 1
+    rects.append((*world_xy(world, (0., sign*10.)), .27, 10.20, world['beam']['pose'][2]))
+    if end == 'teal':
+        # Blue's parking READY guarantees y<=-.625. Teal's centre must stay
+        # above -.25, leaving >=.375m even at the parking tolerance boundary.
+        rects.append((*world_xy(world, (0., -20.)), 40., 19.62, world['beam']['pose'][2]))
+    return radius, discs, rects
+
+
+def checked_path(start, goal, bounds, constraint_set):
+    radius, discs, rects = constraint_set
+    x0, x1, y0, y1 = bounds
+    if not (x0+radius <= goal[0] <= x1-radius and y0+radius <= goal[1] <= y1-radius):return []
+    if not free(goal, discs, rects, radius):return []
+    path = ([tuple(start), tuple(goal)] if segment_free(start, goal, discs, rects, radius)
+            else plan_path(start, goal, bounds, discs, rects=rects, radius=radius))
+    if not path:return []
+    points = [tuple(start), *path]
+    return path if all(segment_free(a,b,discs,rects,radius) for a,b in zip(points,points[1:])) else []
+
+
+class PriorityApproach:
+    def __init__(self, end):
+        self.end = end; self.round = 0; self.park_x = None
+        self.path = []; self.next_plan = 0.; self.blocked_since = None
+        self.events = []
+
+    @property
+    def waiting(self):
+        return self.round == 0 or (self.round == 1 and self.end == 'blue')
+
+    def park_goal(self, world, rid):
+        if self.park_x is None:self.park_x = beam_xy(world, world['robots'][rid]['pose'])[0]
+        return world_xy(world, (self.park_x, PARK_Y))
+
+    def signal(self, teacher, world):
+        if (teacher.outcome is not None or not teacher.folded_ready or world['beam'] is None
+                or world['visibility'][teacher.rid]['visible_probes'] < 5):return False
+        if self.round == 0 and self.end == 'teal':return True
+        pose = world['robots'][teacher.rid]['pose']
+        radius, discs, rects = constraints(world, teacher.rid, teacher.folded_ready)
+        return (self.park_x is not None and math.dist(pose[:2], self.park_goal(world, teacher.rid)) <= PARK_TOL
+                and free(pose[:2], discs, rects, radius))
+
+    def advance(self, teacher, now):
+        self.round += 1
+        self.events.append({'t':now, 'event':'GO_ACK_received', 'round':self.round})
+        teacher.path=[];teacher.path_goal=None;teacher.next_plan=now;teacher.progress.reset()
+        teacher.approach_plan_valid=False
+
+    def step_wait(self, teacher, world, now):
+        """Called after own arm/gaze update, with a currently visible band."""
+        if self.end == 'teal' or self.round == 1:return teacher._hold(now), False
+        goal = self.park_goal(world, teacher.rid)
+        pose = world['robots'][teacher.rid]['pose']
+        cs = constraints(world, teacher.rid, teacher.folded_ready)
+        if self.signal(teacher, world):return teacher._hold(now), False
+        from sim.grasp_act_visible_route import waypoint, drive
+        if now >= self.next_plan:
+            self.path = checked_path(pose[:2], goal, teacher.bounds, cs)
+            self.next_plan = now+1.;teacher.planner_calls+=1
+            self.events.append({'t':now,'event':'parking_route','goal':goal,'path':self.path})
+            self.blocked_since = None if self.path else (now if self.blocked_since is None else self.blocked_since)
+        if self.blocked_since is not None and now-self.blocked_since >= 3.-1e-8:
+            teacher.outcome='approach_blocked_handoff';return teacher._hold(now),False
+        radius, discs, rects = cs
+        target = waypoint(pose[:2], self.path, discs, rects, radius)
+        if target is None:return teacher._hold(now),False
+        return teacher._continuous(now, **drive(pose, goal, target, world['beam']['ends'][self.end])),False
