    "crate": {
      "sha": "727de2af0e5ec10dda0b954e757c2fe42e694766",
      "path": "sim/crate_rgb_lift.py",
      "file_sha256": "e07ea607eca1a5382fe52466e8537c62ab9ba77b55045d7c44f94778965d9654",
      "excerpts": [
        {
          "line": 25,
          "text": "def masks(rgb, end):"
        },
        {
          "line": 26,
          "text": "    \"\"\"Boolean masks of (own lug colour, crate body pink) for a uint8 HxWx3 frame.\"\"\""
        },
        {
          "line": 27,
          "text": "    f = rgb.astype(np.int16)"
        },
        {
          "line": 28,
          "text": "    r, g, b = f[..., 0], f[..., 1], f[..., 2]"
        },
        {
          "line": 29,
          "text": "    blue = (b > 140) & (r < 90) & (g < 90)"
        },
        {
          "line": 30,
          "text": "    teal = (g > 140) & (b > 60) & (b < g) & (r < 90)"
        },
        {
          "line": 31,
          "text": "    lug = teal if end == 'teal' else blue"
        },
        {
          "line": 32,
          "text": "    pink = (r > 90) & (r > g+25) & (b > g-5) & (r > b) & ~lug"
        },
        {
          "line": 33,
          "text": "    return lug, pink"
        }
      ]
    }
  },
