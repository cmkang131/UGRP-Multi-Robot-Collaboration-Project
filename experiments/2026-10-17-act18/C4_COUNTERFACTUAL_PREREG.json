{
  "created_utc": "2026-10-20T05:06:50Z",
  "decision_rules": [
    "n_recovered[V] = number of failure worlds (n=10) with open=True under V and open=False under V0",
    "single cause: exactly one of V-pe/V-se/V-img-same/V-img-cross/V-hist has n_recovered >= 6",
    "multiple: two or more variants reach >= 6; report both, no single-cause attribution",
    "kind-specific visual generalisation: only V-img-cross reaches >= 6",
    "no recovery: no variant reaches >= 6 -> model capacity/data, not a single input",
    "success control (n=9) is descriptive only: V0 must keep open 9/9; variant open counts are reported but do not enter the failure decision"
  ],
  "exclusions_and_limits": [
    "offline replay: outputs are not executed, no physics, not a closed-loop result",
    "the recorded observation sequence is fixed; a counterfactual command does not change later observations (no re-simulation)",
    "failure 10 is the C2c category (b) subset only; the 2 drop_detected and 3 grasp_done_not_requested worlds are not replayed",
    "HO4 is a diagnostic holdout (gate_eligible=false); no pooling with VAL8/FINAL40",
    "kind is fixed per seed and fully confounded with scene placement in the C2c cohort"
  ],
  "experiment": "C4b",
  "fidelity": {
    "abort_on_failure": true,
    "check": "V0 te_pwm1 must reproduce the recorded owner issued pwm1 for every window tick; open status must match 19/19",
    "exact_fraction_min": 0.95,
    "max_abs_diff": 1,
    "open_status": "19/19"
  },
  "inputs_replaced": {
    "V-hist": "the 16 issued-command contents := the same-kind success world history at the same release-relative time; the target timestamps are kept so only the command contents change",
    "V-img-cross": "the four own-RGB references of every tick := the next-kind success world tick (cyan->green->red->yellow->cyan) at the same release-relative time; times shifted as for V-img-same",
    "V-img-same": "the four own-RGB references of every tick := the same-kind success world tick at the same release-relative time; times shifted so the newest reference equals the target tick",
    "V-pe": "pwm_elapsed_s := 14.5 on every window tick",
    "V-se": "skill_elapsed_s := 4.45 on every window tick",
    "V0": "none (baseline fidelity replay)"
  },
  "metrics": {
    "open_tau": "release-relative time of the first open tick",
    "primary": "te_pwm1 = deployed temporal-ensemble command (coefficient 0.01, n_action_steps 1, skill transition resets the buffer) decoded with contract.decode_action; open = any window tick with te_pwm1 >= 1900",
    "secondary": "raw_pwm1 = chunk row 0 before ensembling; done_freeze = the executor stop rule of harness.grasp_act_policy.ChunkExecutor"
  },
  "question": "C2c release world 10 failure / 9 success: does replacing exactly one policy input during the first 8 s after release entry produce the open command (pwm1 >= 1900) that the failure worlds never issued?",
